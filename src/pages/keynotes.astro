---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { nav } from "../utils";

const announced = (await getCollection("keynotes", ({ data }) => data.announced)).sort((a, b) => a.data.day - b.data.day);

const dayLabel = (day: number) =>
  day === 1 ? "Monday 1 Feb" : day === 2 ? "Tuesday 2 Feb" : "Wednesday 3 Feb";

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<Base title="Keynote Speakers" description="Keynote speakers of the 2027 DRAKKAR Ocean Modelling Workshop.">
  <PageHeader
    title="Keynote Speakers"
    subtitle="Each day, a young scientist presents recently published work in a 25&ndash;30 min keynote talk followed by 20 minutes of questions and answers."
  />

  <section class="mx-auto max-w-6xl space-y-6 px-4 py-12">
    {
      announced.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
          <p class="text-lg font-semibold text-slate-900">Keynote speakers to be announced</p>
          <p class="mt-2 text-sm text-slate-500">Names, affiliations and talk details will be published here.</p>
        </div>
      ) : (
        announced.map((k) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md md:p-8">
          <div class="flex flex-col gap-5 md:flex-row md:items-start">
            <div class="flex items-center gap-4">
              {k.data.photo ? (
                <img
                  src={nav(`keynotes/${k.data.photo}`)}
                  alt={k.data.speaker}
                  class="h-16 w-16 shrink-0 rounded-full object-cover object-top md:h-24 md:w-24"
                />
              ) : (
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-ocean-600 to-teal-500 text-xl font-bold text-white">
                  {initials(k.data.speaker)}
                </div>
              )}
              <div class="md:hidden">
                <h2 class="text-lg font-bold text-slate-900">{k.data.speaker}</h2>
                <p class="text-sm text-slate-500">{k.data.affiliation}</p>
              </div>
            </div>
            <div class="flex-1">
              <div class="hidden md:block">
                <h2 class="text-lg font-bold text-slate-900">{k.data.speaker}</h2>
                <p class="text-sm text-slate-500">{k.data.affiliation}</p>
              </div>
              <span class="mt-2 inline-block rounded-full bg-ocean-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-ocean-700">
                {dayLabel(k.data.day)} &middot; {k.data.time}
              </span>
              <h3 class="mt-4 font-semibold text-ocean-800">{k.data.talkTitle ?? "Talk title to be announced"}</h3>
              {(k.data.bio || k.data.abstract) && (
                <details class="mt-3 text-sm text-slate-600">
                  <summary class="cursor-pointer font-medium text-ocean-600 hover:text-ocean-800">
                    Biography &amp; abstract
                  </summary>
                  {k.data.bio && (
                    <p class="mt-3 leading-relaxed"><span class="font-semibold text-slate-800">Bio. </span>{k.data.bio}</p>
                  )}
                  {k.data.abstract && (
                    <p class="mt-3 leading-relaxed"><span class="font-semibold text-slate-800">Abstract. </span>{k.data.abstract}</p>
                  )}
                </details>
              )}
              {!(k.data.bio || k.data.abstract) && (
                <p class="mt-3 text-sm text-slate-500">Biography and abstract will be published here soon.</p>
              )}
              {k.data.link && (
                <a
                  href={k.data.link}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-block font-medium text-ocean-600 hover:underline"
                >
                  Speaker webpage &rarr;
                </a>
              )}
              {k.data.relatedPapers && k.data.relatedPapers.length > 0 && (
                <div class="mt-3 text-sm">
                  <p class="font-semibold text-slate-800">Related papers:</p>
                  <ul class="mt-1 list-disc space-y-1 pl-5">
                    {k.data.relatedPapers.map((paper) => (
                      <li>
                        <a
                          href={paper.url}
                          target="_blank"
                          rel="noopener"
                          class="font-medium text-ocean-600 hover:underline"
                        >
                          {paper.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </article>
        ))
      )
    }
  </section>
</Base>

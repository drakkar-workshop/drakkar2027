---
import Base from "../layouts/Base.astro";
import { nav } from "../utils";
---

<Base
  title="Page not found"
  description="The requested page could not be found on the 2027 DRAKKAR Ocean Modelling Workshop website."
>
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-32 text-center">
    <p class="text-7xl font-extrabold tracking-tight text-ocean-200">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-ocean-900 md:text-3xl">Page not found</h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600">
      The page you are looking for does not exist or has been moved.
    </p>
    <a
      href={nav()}
      class="mt-8 rounded-full bg-ocean-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-ocean-700"
    >
      Back to the homepage
    </a>
  </section>
</Base>

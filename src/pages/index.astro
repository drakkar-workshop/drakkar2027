---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { SITE, THEMES, SCIENTIFIC_COMMITTEE, ORGANIZING_COMMITTEE } from "../config";
import { getCollection } from "astro:content";
import { nav } from "../utils";

const announced = (await getCollection("keynotes", ({ data }) => data.announced)).sort((a, b) => a.data.day - b.data.day);

const dayLabel = (day: number) =>
  day === 1 ? "Monday 1 Feb" : day === 2 ? "Tuesday 2 Feb" : "Wednesday 3 Feb";

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();

const registerHref = SITE.links.registration || "#";
const abstractHref = SITE.links.abstractSubmission || "#";
---

<Base title={SITE.title}>
  <Hero />

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-bold tracking-tight text-ocean-900 md:text-3xl">About the workshop</h2>
        {SITE.intro.map((paragraph) => <p class="mt-5 leading-relaxed text-slate-600">{paragraph}</p>)}
        <a
          href={SITE.links.livestream}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-ocean-200 bg-ocean-50 px-4 py-2 text-sm font-semibold text-ocean-700 transition hover:border-ocean-300 hover:bg-ocean-100"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.14v14l11-7-11-7z"></path>
          </svg>
          Watch online (upon registration)
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 lg:col-span-2">
        <div class="rounded-2xl border border-ocean-100 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-ocean-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2Z"></path>
            </svg>
            <h3 class="text-sm font-bold text-ocean-900">Dates</h3>
          </div>
          <p class="mt-2 text-sm text-slate-600">{SITE.datesLabel}</p>
        </div>
        <div class="rounded-2xl border border-ocean-100 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-ocean-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
            </svg>
            <h3 class="text-sm font-bold text-ocean-900">Venue</h3>
          </div>
          <p class="mt-2 text-sm text-slate-600">IMAG Building, 700 Av. Centrale, Saint-Martin-d'H&egrave;res</p>
          <a href={SITE.venue.mapsUrl} target="_blank" rel="noopener" class="mt-2 inline-block text-xs font-semibold text-ocean-600 hover:underline">
            Open in Google Maps
          </a>
        </div>
        <div class="rounded-2xl border border-ocean-100 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-ocean-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5M3.75 3h16.5m0 0h1.5m-1.5 0v11.25a2.25 2.25 0 0 1-2.25 2.25h-2.25m2.25-13.5L18.75 7.5m-13.5 0L3.75 3m9 12h1.5a2.25 2.25 0 0 1 0 4.5h-.75a.75.75 0 0 0-.75.75v.75a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75v-.75a.75.75 0 0 0-.75-.75h-.75a2.25 2.25 0 0 1 0-4.5H12"></path>
            </svg>
            <h3 class="text-sm font-bold text-ocean-900">Format</h3>
          </div>
          <p class="mt-2 text-sm text-slate-600">
            Posters &amp; short talks, keynotes, plenary discussions and hands-on sessions
          </p>
        </div>
        <div class="rounded-2xl border border-ocean-100 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-ocean-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5.14v14l11-7-11-7z"></path>
            </svg>
            <h3 class="text-sm font-bold text-ocean-900">Online</h3>
          </div>
          <p class="mt-2 text-sm text-slate-600">Selected sessions streamed live, upon registration</p>
          <a href={SITE.links.livestream} target="_blank" rel="noopener" class="mt-2 inline-block text-xs font-semibold text-ocean-600 hover:underline">
            Livestream link
          </a>
          <br />
          <a href={SITE.links.youtube} target="_blank" rel="noopener" class="mt-1 inline-block text-xs font-semibold text-ocean-600 hover:underline">
            Previous editions on YouTube
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-sm font-semibold uppercase tracking-widest text-ocean-600">Workshop themes</h3>
      <div class="mt-4 grid gap-6 md:grid-cols-3">
        {
          THEMES.map((theme, index) => (
            <article class="rounded-2xl border border-ocean-100 bg-white p-6 shadow-sm transition hover:shadow-md">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-ocean-600 to-teal-500 text-sm font-bold text-white">
                {String(index + 1).padStart(2, "0")}
              </div>
              <h4 class="mt-4 font-bold text-ocean-900">{theme.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{theme.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-ocean-900 md:text-3xl">Keynote speakers</h2>
          <p class="mt-2 max-w-2xl text-slate-600">
            Three young scientists present recently published work in 25&ndash;30 min talks followed by Q&amp;A.
          </p>
        </div>
        <a href={nav("keynotes")} class="text-sm font-semibold text-ocean-600 hover:text-ocean-800">
          See all keynotes &rarr;
        </a>
      </div>
      <div class="mt-8">
        {
          announced.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
              <p class="text-lg font-semibold text-slate-900">Keynote speakers will be announced soon</p>
              <p class="mt-2 text-sm text-slate-500">Names, affiliations and talk details will be published here.</p>
            </div>
          ) : (
            <div class="grid gap-6 md:grid-cols-3">
              {announced.map((k) => (
                <article class="rounded-2xl border border-slate-200 bg-ocean-50/60 p-6 transition hover:shadow-md">
                  <div class="flex items-center gap-4">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-ocean-600 to-teal-500 text-lg font-bold text-white">
                      {initials(k.data.speaker)}
                    </div>
                    <div>
                      <h3 class="font-bold text-slate-900">{k.data.speaker}</h3>
                      <p class="text-xs text-slate-500">{k.data.affiliation}</p>
                    </div>
                  </div>
                  <p class="mt-4 text-sm font-semibold text-ocean-800">{k.data.talkTitle ?? "Talk title to be announced"}</p>
                  <p class="mt-3 inline-block rounded-full bg-ocean-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-ocean-700">
                    {dayLabel(k.data.day)} &middot; {k.data.time}
                  </p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <h2 class="text-2xl font-bold tracking-tight text-ocean-900 md:text-3xl">Committees</h2>
    <div class="mt-8 grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold uppercase tracking-widest text-ocean-600">Scientific committee</h3>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            SCIENTIFIC_COMMITTEE.map((member) => (
              <div class="flex items-center gap-3 rounded-xl border border-ocean-100 bg-white p-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ocean-100 text-xs font-bold text-ocean-700">
                  {initials(member.name)}
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-900">{member.name}</p>
                  <p class="text-xs text-slate-500">{member.affiliation}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-ocean-600">Organizing committee</h3>
        <div class="mt-4 space-y-3">
          {
            ORGANIZING_COMMITTEE.map((member) => (
              <div class="flex items-center gap-3 rounded-xl border border-ocean-100 bg-white p-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-100 text-xs font-bold text-teal-700">
                  {initials(member.name)}
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-900">{member.name}</p>
                  <p class="text-xs text-slate-500">{member.affiliation}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4">
    <div class="rounded-3xl bg-gradient-to-br from-ocean-900 to-ocean-600 px-8 py-12 text-center text-white shadow-xl">
      <h2 class="text-2xl font-bold tracking-tight md:text-3xl">Join us in Grenoble, 1&ndash;3 February 2027</h2>
      <p class="mx-auto mt-3 max-w-xl text-ocean-200">
        Present your work, discuss with the DRAKKAR community and the wider ocean-modelling world, and shape the future of ocean modelling.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={registerHref}
          class="rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-ocean-950 shadow-lg shadow-amber-400/30 transition hover:bg-amber-300"
        >
          Register
        </a>
        <a
          href={abstractHref}
          class="rounded-full border border-white/25 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
        >
          Submit an abstract
        </a>
      </div>
      <p class="mt-3 text-xs text-ocean-300">Links will be published here when registration and abstract submission open.</p>
    </div>
  </section>
</Base>

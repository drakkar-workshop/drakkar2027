---
import { SITE } from "../config";
import Waves from "./Waves.astro";

const registerHref = SITE.links.registration || "#";
const abstractHref = SITE.links.abstractSubmission || "#";
const hasRegisterLink = Boolean(SITE.links.registration);
const hasAbstractLink = Boolean(SITE.links.abstractSubmission);
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-ocean-950 via-ocean-800 to-ocean-600 text-white"
>
  <div class="pointer-events-none absolute -right-24 -top-32 h-96 w-96 rounded-full bg-ocean-400/20 blur-3xl">
  </div>
  <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-teal-400/10 blur-3xl"></div>
  <div class="relative mx-auto max-w-6xl px-4 pb-28 pt-20 md:pt-28">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-ocean-300/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-ocean-200"
    >
      {SITE.edition} &middot; NEMO ocean modelling
    </span>
    <h1 class="mt-6 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight md:text-6xl">
      2027 DRAKKAR Ocean Modelling Workshop
    </h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-lg text-ocean-100">
      <span class="inline-flex items-center gap-2">
        <svg class="h-5 w-5 text-ocean-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2Z"></path>
        </svg>
        {SITE.datesLabel}
      </span>
      <span class="inline-flex items-center gap-2">
        <svg class="h-5 w-5 text-ocean-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"></path>
        </svg>
        {SITE.location}
      </span>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={registerHref}
        class="rounded-full bg-amber-400 px-6 py-3 text-sm font-bold text-ocean-950 shadow-lg shadow-amber-400/30 transition hover:bg-amber-300"
      >
        {hasRegisterLink ? "Register now" : "Registration \u2014 opening soon"}
      </a>
      <a
        href={abstractHref}
        class="rounded-full border border-white/25 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
      >
        {hasAbstractLink ? "Submit an abstract" : "Abstract submission \u2014 opening soon"}
      </a>
    </div>
    <p class="mt-3 text-sm text-ocean-300">
      Registration and abstract submission links will be published here.
    </p>
    <div id="countdown" class="mt-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-ocean-300">Starts in</p>
      <div class="mt-3 flex gap-3">
        {
          [
            { id: "cd-days", label: "days" },
            { id: "cd-hours", label: "hours" },
            { id: "cd-mins", label: "minutes" },
            { id: "cd-secs", label: "seconds" },
          ].map((unit) => (
            <div class="min-w-20 rounded-xl border border-white/15 bg-white/10 px-3 py-2 text-center backdrop-blur">
              <div class="text-2xl font-bold tabular-nums" id={unit.id}>
                --
              </div>
              <div class="text-[10px] font-semibold uppercase tracking-widest text-ocean-300">{unit.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <Waves className="text-ocean-50" />
</section>

<script>
  const target = new Date("2027-02-01T09:00:00+01:00").getTime();
  const countdown = document.getElementById("countdown");
  const setValue = (id: string, value: string) => {
    const node = document.getElementById(id);
    if (node) node.textContent = value;
  };
  const tick = () => {
    const diff = target - Date.now();
    if (!countdown) return;
    if (diff <= 0) {
      countdown.innerHTML =
        '<p class="text-lg font-semibold text-ocean-100">The workshop is underway \u2014 see you in Grenoble!</p>';
      return;
    }
    setValue("cd-days", String(Math.floor(diff / 86400000)));
    setValue("cd-hours", String(Math.floor(diff / 3600000) % 24).padStart(2, "0"));
    setValue("cd-mins", String(Math.floor(diff / 60000) % 60).padStart(2, "0"));
    setValue("cd-secs", String(Math.floor(diff / 1000) % 60).padStart(2, "0"));
  };
  tick();
  setInterval(tick, 1000);
</script>

---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="mx-auto max-w-6xl px-4">
  <div
    class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-relaxed text-amber-900"
  >
    <svg
      class="mt-0.5 h-5 w-5 shrink-0 text-amber-500"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
      ></path>
    </svg>
    <p>{text}</p>
  </div>
</div>

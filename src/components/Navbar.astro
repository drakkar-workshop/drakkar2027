---
import { nav } from "../utils";

const items = [
  { label: "Home", path: "" },
  { label: "Program", path: "program" },
  { label: "Keynotes", path: "keynotes" },
  { label: "Posters", path: "posters" },
  { label: "Practical info", path: "practical" },
];
const current = Astro.url.pathname.replace(/\/+$/, "");
const isActive = (path: string) => current === nav(path).replace(/\/+$/, "");
---

<header class="sticky top-0 z-50 border-b border-ocean-800/60 bg-ocean-950/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href={nav()} class="flex items-center gap-2.5 text-white">
      <svg class="h-9 w-9" viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <path d="M32 12 L48 44 L16 44 Z" fill="#5aa9d6"></path>
        <path
          d="M10 50 q6 -6 12 0 t12 0 t12 0 t12 0"
          stroke="#14b8a6"
          stroke-width="5"
          fill="none"
          stroke-linecap="round"></path>
      </svg>
      <span class="text-lg font-bold tracking-tight">DRAKKAR <span class="text-ocean-300">2027</span></span>
    </a>
    <div class="hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={nav(item.path)}
            class={`rounded-full px-4 py-2 text-sm font-medium transition ${
              isActive(item.path)
                ? "bg-white/15 text-white"
                : "text-ocean-200 hover:bg-white/10 hover:text-white"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <button
      id="menu-btn"
      class="rounded-lg p-2 text-ocean-100 hover:bg-white/10 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-ocean-800/60 md:hidden">
    <div class="space-y-1 px-4 py-3">
      {
        items.map((item) => (
          <a
            href={nav(item.path)}
            class={`block rounded-lg px-3 py-2 text-sm font-medium ${
              isActive(item.path) ? "bg-white/15 text-white" : "text-ocean-100 hover:bg-white/10"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", menu ? String(!menu.classList.contains("hidden")) : "false");
  });
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => menu.classList.add("hidden"))
  );
</script>
